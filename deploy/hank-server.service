[Unit]
Description=Hank Agent Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hank
Group=hank
WorkingDirectory=/opt/hank/current
Environment=HOME=/home/hank
Environment=CONFIG_PATH=/opt/hank/config.toml
ExecStart=/opt/hank/current/hank-server
Restart=always
RestartSec=3
# 日志由应用自身写入 logs/ 目录，stdout 同时进 journal
StandardOutput=journal
StandardError=journal
# server 不再执行任何代码 Agent，也不调用 root helper，可以彻底禁止提权
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/home/hank /opt/hank/logs
UMask=0007

[Install]
WantedBy=multi-user.target
