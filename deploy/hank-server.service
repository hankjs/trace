[Unit]
Description=Hank Agent Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hank
ExecStart=/opt/hank/hank-server
Restart=always
RestartSec=3
# 日志由应用自身写入 logs/ 目录，stdout 同时进 journal
StandardOutput=journal
StandardError=journal
# 基础加固
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=/opt/hank/logs

[Install]
WantedBy=multi-user.target
