[Unit]
Description=Hank Quant - A股日频量化信息系统
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hank-quant
# 生产环境:启用 APScheduler(日线/盘中/估值等定时任务);本地 dev 默认不启
Environment=QUANT_ENV=prod
ExecStart=/opt/hank-quant/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8100
Restart=always
RestartSec=3
# stdout 进 journal: journalctl -u hank-quant
StandardOutput=journal
StandardError=journal
# 基础加固
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
