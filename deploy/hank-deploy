#!/usr/bin/env bash
# Trace monorepo 的 root-owned 部署 helper。
#
# 只接受一个 UUID。manifest 由 hank-server 写入 /opt/hank/deploy-jobs，
# 本脚本不接受任意 shell 命令；首次调用会转成独立 systemd transient unit，
# 这样重启 hank-server 不会杀掉部署进程。
set -Eeuo pipefail

JOB_ID="${2:-${1:-}}"
if [[ ! "$JOB_ID" =~ ^[0-9a-fA-F-]{36}$ ]]; then
  echo "invalid deployment id" >&2
  exit 2
fi

if [[ "${1:-}" != "--worker" ]]; then
  exec systemd-run --quiet --collect \
    --unit="hank-deploy-${JOB_ID}" \
    --property=Type=oneshot \
    --property=UMask=0027 \
    /usr/local/libexec/hank-deploy --worker "$JOB_ID"
fi

JOB_ROOT="/opt/hank/deploy-jobs"
MANIFEST="$JOB_ROOT/$JOB_ID.json"
RESULT="$JOB_ROOT/$JOB_ID.result.json"
SOURCE_ROOT="/opt/hank-worktrees"
CORE_ROOT="/opt/hank"
CLI_ROOT="/opt/hank-cli"
QUANT_ROOT="/opt/hank-quant"
SLIDEV_ROOT="/opt/hank-quant-slidev"
DOCS_ROOT="/opt/hank-docs"
HANK_USER="hank"
BUILD_USER="hank-build"
BUILD_HOME="/home/hank-build"
BUILD_PATH="$BUILD_HOME/.cargo/bin:$BUILD_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
BUILD_SOURCE=""

cleanup_source() {
  if [[ -n "$BUILD_SOURCE" && "$BUILD_SOURCE" == "/var/tmp/hank-build.$JOB_ID."* ]]; then
    rm -rf -- "$BUILD_SOURCE"
  fi
}
trap cleanup_source EXIT

write_result() {
  local status="$1"
  local message="${2:-}"
  local error="${3:-}"
  local tmp="$RESULT.tmp"
  python3 - "$tmp" "$status" "$message" "$error" <<'PY'
import json
import os
import grp
import sys

path, status, message, error = sys.argv[1:]
payload = {"status": status}
if message:
    payload["message"] = message
if error:
    payload["error"] = error
with open(path, "w", encoding="utf-8") as f:
    json.dump(payload, f, ensure_ascii=False)
    f.write("\n")
final_path = path[:-4] if path.endswith(".tmp") else path
os.replace(path, final_path)
os.chown(final_path, -1, grp.getgrnam("hank").gr_gid)
os.chmod(final_path, 0o640)
PY
}

on_error() {
  local code=$?
  trap - ERR
  if declare -F rollback >/dev/null && rollback; then
    write_result "rolled_back" "" "部署脚本失败（exit $code），已切回上一版本" || true
  else
    write_result "failed" "" "部署脚本失败（exit $code），请检查 journalctl -u hank-deploy-$JOB_ID" || true
  fi
  exit "$code"
}
trap on_error ERR

if ! id "$HANK_USER" >/dev/null 2>&1; then
  write_result failed "" "缺少部署用户 $HANK_USER，请先执行 bootstrap-server-agent.sh"
  exit 1
fi
if ! id "$BUILD_USER" >/dev/null 2>&1; then
  write_result failed "" "缺少构建用户 $BUILD_USER，请先执行 bootstrap-server-agent.sh"
  exit 1
fi

# 所有目标共用一把锁，避免两个审批同时切换 release 或推进生产基线。
exec 9>/run/lock/hank-deploy.lock
if ! flock -n 9; then
  write_result failed "" "已有部署任务正在执行，请稍后重新发起 /deploy"
  exit 1
fi

if [[ ! -f "$MANIFEST" ]]; then
  write_result failed "" "缺少部署 manifest: $MANIFEST"
  exit 1
fi

mapfile -t META < <(python3 - "$MANIFEST" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as f:
    data = json.load(f)
if data.get("version") != 1:
    raise SystemExit("unsupported manifest version")
action = data.get("action", "deploy")
if action not in {"deploy", "rollback"}:
    raise SystemExit("unsupported deployment action")
source = data.get("source_dir", "")
base_sha = data.get("base_sha", "")
sha = data.get("commit_sha", "")
import re
if not re.fullmatch(r"/opt/hank-worktrees/[0-9a-fA-F-]{36}", source):
    raise SystemExit("source outside allowed worktree root")
if len(sha) != 40 or any(c not in "0123456789abcdefABCDEF" for c in sha):
    raise SystemExit("invalid commit sha")
if len(base_sha) != 40 or any(c not in "0123456789abcdefABCDEF" for c in base_sha):
    raise SystemExit("invalid base sha")
print(source)
print(base_sha)
print(sha)
print("1" if data.get("migration_required") else "0")
print(action)
for target in data.get("targets", []):
    if target not in {"core", "cli", "docs"}:
        raise SystemExit(f"unsupported target: {target} (quant 已独立仓库，请在 hankjs/quant 部署)")
    print(target)
PY
)
SOURCE_DIR="${META[0]}"
BASE_SHA="${META[1]}"
COMMIT_SHA="${META[2]}"
MIGRATION_REQUIRED="${META[3]}"
ACTION="${META[4]}"
TARGETS=("${META[@]:5}")
ORDERED_TARGETS=()
for wanted in cli docs core; do
  for target in "${TARGETS[@]}"; do
    [[ "$target" == "$wanted" ]] && ORDERED_TARGETS+=("$target")
  done
done
TARGETS=("${ORDERED_TARGETS[@]}")

if [[ ${#TARGETS[@]} -eq 0 ]]; then
  write_result failed "" "部署 manifest 没有目标"
  exit 1
fi

if [[ "$MIGRATION_REQUIRED" == "1" ]]; then
  write_result failed "" "检测到 migration_required=true；必须在维护窗口单独执行迁移"
  exit 1
fi

as_hank() {
  runuser --user "$HANK_USER" -- env \
    HOME="/home/$HANK_USER" \
    PATH="/usr/local/bin:/usr/bin:/bin" \
    "$@"
}

as_builder() {
  runuser --user "$BUILD_USER" -- env \
    HOME="$BUILD_HOME" \
    PATH="$BUILD_PATH" \
    "$@"
}

if [[ "$ACTION" == "deploy" ]]; then
  SOURCE_DIR="$(realpath "$SOURCE_DIR")"
  if [[ "$SOURCE_DIR" != "$SOURCE_ROOT/"* || ! -d "$SOURCE_DIR" || ! -e "$SOURCE_DIR/.git" ]]; then
    write_result failed "" "源码 worktree 不存在或不是 Git worktree"
    exit 1
  fi
  if [[ "$(as_builder git -C "$SOURCE_DIR" rev-parse HEAD)" != "$COMMIT_SHA" ]]; then
    write_result failed "" "源码 worktree HEAD 与审批 commit 不一致"
    exit 1
  fi
  if [[ "$(as_hank git -C /opt/hank-src rev-parse trace-production)" != "$BASE_SHA" ]]; then
    write_result failed "" "生产基线已变化，请在新话题工作区重新应用变更"
    exit 1
  fi
  if [[ -n "$(as_builder git -C "$SOURCE_DIR" status --porcelain --untracked-files=all)" ]]; then
    write_result failed "" "源码 worktree 不是 clean 状态"
    exit 1
  fi
elif [[ "$(as_hank git -C /opt/hank-src rev-parse trace-production)" != "$COMMIT_SHA" ]]; then
  write_result failed "" "生产基线已变化，不能执行该回滚"
  exit 1
fi

reject_symlinks() {
  local path="$1"
  if [[ -n "$(find "$path" -type l -print -quit)" ]]; then
    write_result failed "" "构建产物包含符号链接，拒绝由 root 安装: $path"
    return 1
  fi
}

atomic_link() {
  local target="$1"
  local link="$2"
  local tmp="$link.tmp.$JOB_ID"
  rm -f "$tmp"
  ln -s "$target" "$tmp"
  mv -Tf "$tmp" "$link"
}

health_check() {
  local url="$1"
  for _ in $(seq 1 15); do
    if curl -fsS -m 3 "$url" >/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

if [[ "$ACTION" == "deploy" ]]; then
  # 审批后 worktree 仍可能收到新消息。所有构建都从审批 commit 的一次性快照进行，
  # 避免校验 HEAD 后到实际构建之间混入未审批内容。
  BUILD_SOURCE="$(mktemp -d "/var/tmp/hank-build.$JOB_ID.XXXXXX")"
  chown "$BUILD_USER:$BUILD_USER" "$BUILD_SOURCE"
  as_builder git -C "$SOURCE_DIR" archive --format=tar "$COMMIT_SHA" \
    | as_builder tar -xf - -C "$BUILD_SOURCE"
  reject_symlinks "$BUILD_SOURCE"
fi

resolve_link() {
  local link="$1"
  [[ -L "$link" ]] || return 0
  readlink -f "$link" 2>/dev/null || true
}

PREV_CORE="$(resolve_link "$CORE_ROOT/current")"
PREV_CLI="$(resolve_link "$CLI_ROOT/current")"
PREV_QUANT="$(resolve_link "$QUANT_ROOT/current")"
PREV_SLIDEV="$(resolve_link "$SLIDEV_ROOT/current")"
PREV_DOCS="$(resolve_link "$DOCS_ROOT/current")"
ROLLBACK_CORE="$(resolve_link "$CORE_ROOT/previous")"
ROLLBACK_CLI="$(resolve_link "$CLI_ROOT/previous")"
ROLLBACK_QUANT="$(resolve_link "$QUANT_ROOT/previous")"
ROLLBACK_SLIDEV="$(resolve_link "$SLIDEV_ROOT/previous")"
ROLLBACK_DOCS="$(resolve_link "$DOCS_ROOT/previous")"
SWITCHED_TARGETS=()
REF_SWITCHED=0

rollback() {
  local rolled=0
  local i target
  for ((i=${#SWITCHED_TARGETS[@]} - 1; i>=0; i--)); do
    target="${SWITCHED_TARGETS[$i]}"
    case "$target" in
      core)
        [[ -n "$PREV_CORE" && -d "$PREV_CORE" ]] || continue
        atomic_link "$PREV_CORE" "$CORE_ROOT/current"
        [[ -z "$ROLLBACK_CORE" ]] || atomic_link "$ROLLBACK_CORE" "$CORE_ROOT/previous"
        systemctl restart hank-server || true
        ;;
      cli)
        [[ -n "$PREV_CLI" && -d "$PREV_CLI" ]] || continue
        atomic_link "$PREV_CLI" "$CLI_ROOT/current"
        [[ -z "$ROLLBACK_CLI" ]] || atomic_link "$ROLLBACK_CLI" "$CLI_ROOT/previous"
        systemctl restart hank-cli || true
        ;;
      quant)
        [[ -n "$PREV_QUANT" && -d "$PREV_QUANT" ]] || continue
        atomic_link "$PREV_QUANT" "$QUANT_ROOT/current"
        [[ -z "$ROLLBACK_QUANT" ]] || atomic_link "$ROLLBACK_QUANT" "$QUANT_ROOT/previous"
        systemctl restart hank-quant || true
        ;;
      quant_slidev)
        [[ -n "$PREV_SLIDEV" && -d "$PREV_SLIDEV" ]] || continue
        atomic_link "$PREV_SLIDEV" "$SLIDEV_ROOT/current"
        [[ -z "$ROLLBACK_SLIDEV" ]] || atomic_link "$ROLLBACK_SLIDEV" "$SLIDEV_ROOT/previous"
        nginx -t && systemctl reload nginx || true
        ;;
      docs)
        [[ -n "$PREV_DOCS" && -d "$PREV_DOCS" ]] || continue
        atomic_link "$PREV_DOCS" "$DOCS_ROOT/current"
        [[ -z "$ROLLBACK_DOCS" ]] || atomic_link "$ROLLBACK_DOCS" "$DOCS_ROOT/previous"
        nginx -t && systemctl reload nginx || true
        ;;
    esac
    rolled=1
  done
  if [[ "$REF_SWITCHED" == "1" ]]; then
    if [[ "$ACTION" == "deploy" ]]; then
      as_hank git -C /opt/hank-src update-ref refs/heads/trace-production "$BASE_SHA" "$COMMIT_SHA" || true
    else
      as_hank git -C /opt/hank-src update-ref refs/heads/trace-production "$COMMIT_SHA" "$BASE_SHA" || true
    fi
  fi
  return "$((rolled ? 0 : 1))"
}

if [[ "$ACTION" == "rollback" ]]; then
  for target in "${TARGETS[@]}"; do
    case "$target" in
      core) candidate="$ROLLBACK_CORE" ;;
      cli) candidate="$ROLLBACK_CLI" ;;
      quant) candidate="$ROLLBACK_QUANT" ;;
      quant_slidev) candidate="$ROLLBACK_SLIDEV" ;;
      docs) candidate="$ROLLBACK_DOCS" ;;
    esac
    case "$target" in
      core) current="$PREV_CORE" ;;
      cli) current="$PREV_CLI" ;;
      quant) current="$PREV_QUANT" ;;
      quant_slidev) current="$PREV_SLIDEV" ;;
      docs) current="$PREV_DOCS" ;;
    esac
    if [[ -z "$current" || ! -d "$current" || -z "$candidate" || ! -d "$candidate" ]]; then
      write_result failed "" "$target 没有可用的 previous release"
      exit 1
    fi
  done

  write_result building "开始回滚 ${#TARGETS[@]} 个目标"
  for target in "${TARGETS[@]}"; do
    case "$target" in
      core)
        atomic_link "$PREV_CORE" "$CORE_ROOT/previous"
        atomic_link "$ROLLBACK_CORE" "$CORE_ROOT/current"
        SWITCHED_TARGETS+=(core)
        systemctl restart hank-server
        health_check "http://127.0.0.1:3000/api/health"
        ;;
      cli)
        atomic_link "$PREV_CLI" "$CLI_ROOT/previous"
        atomic_link "$ROLLBACK_CLI" "$CLI_ROOT/current"
        SWITCHED_TARGETS+=(cli)
        systemctl restart hank-cli
        systemctl is-active --quiet hank-cli
        ;;
      quant)
        atomic_link "$PREV_QUANT" "$QUANT_ROOT/previous"
        atomic_link "$ROLLBACK_QUANT" "$QUANT_ROOT/current"
        SWITCHED_TARGETS+=(quant)
        systemctl restart hank-quant
        health_check "http://127.0.0.1:8100/api/health"
        ;;
      quant_slidev)
        atomic_link "$PREV_SLIDEV" "$SLIDEV_ROOT/previous"
        atomic_link "$ROLLBACK_SLIDEV" "$SLIDEV_ROOT/current"
        SWITCHED_TARGETS+=(quant_slidev)
        nginx -t
        systemctl reload nginx
        health_check "http://127.0.0.1:3030/"
        ;;
      docs)
        atomic_link "$PREV_DOCS" "$DOCS_ROOT/previous"
        atomic_link "$ROLLBACK_DOCS" "$DOCS_ROOT/current"
        SWITCHED_TARGETS+=(docs)
        nginx -t
        systemctl reload nginx
        health_check "http://127.0.0.1:3002/"
        ;;
    esac
  done
  as_hank git -C /opt/hank-src update-ref refs/heads/trace-production "$BASE_SHA" "$COMMIT_SHA"
  REF_SWITCHED=1
  write_result succeeded "回滚完成，所有目标健康检查通过"
  exit 0
fi

write_result building "开始构建 ${#TARGETS[@]} 个目标"
for target in "${TARGETS[@]}"; do
  case "$target" in
    core)
      mkdir -p "$CORE_ROOT/releases/$JOB_ID"
      # 发布不执行测试（测试由提交前负责）
      as_builder cargo build --release --locked --manifest-path "$BUILD_SOURCE/Cargo.toml" -p hank-server
      as_builder bash -c "cd '$BUILD_SOURCE/admin' && pnpm install --frozen-lockfile && pnpm build"
      [[ -f "$BUILD_SOURCE/target/release/hank-server" && ! -L "$BUILD_SOURCE/target/release/hank-server" ]]
      reject_symlinks "$BUILD_SOURCE/admin/dist"
      install -m 755 "$BUILD_SOURCE/target/release/hank-server" "$CORE_ROOT/releases/$JOB_ID/hank-server"
      mkdir -p "$CORE_ROOT/releases/$JOB_ID/admin"
      rsync -a --delete --no-links "$BUILD_SOURCE/admin/dist/" "$CORE_ROOT/releases/$JOB_ID/admin/dist/"
      ln -s "$CORE_ROOT/logs" "$CORE_ROOT/releases/$JOB_ID/logs"
      [[ -n "$PREV_CORE" ]] && atomic_link "$PREV_CORE" "$CORE_ROOT/previous"
      atomic_link "$CORE_ROOT/releases/$JOB_ID" "$CORE_ROOT/current"
      SWITCHED_TARGETS+=(core)
      systemctl restart hank-server
      health_check "http://127.0.0.1:3000/api/health"
      ;;
    cli)
      mkdir -p "$CLI_ROOT/releases/$JOB_ID"
      # 发布不执行测试（测试由提交前负责）
      as_builder cargo build --release --locked --manifest-path "$BUILD_SOURCE/cli/Cargo.toml"
      [[ -f "$BUILD_SOURCE/cli/target/release/hank-cli" && ! -L "$BUILD_SOURCE/cli/target/release/hank-cli" ]]
      install -m 755 "$BUILD_SOURCE/cli/target/release/hank-cli" "$CLI_ROOT/releases/$JOB_ID/hank-cli"
      [[ -n "$PREV_CLI" ]] && atomic_link "$PREV_CLI" "$CLI_ROOT/previous"
      atomic_link "$CLI_ROOT/releases/$JOB_ID" "$CLI_ROOT/current"
      SWITCHED_TARGETS+=(cli)
      systemctl restart hank-cli
      systemctl is-active --quiet hank-cli
      ;;
    quant)
      mkdir -p "$QUANT_ROOT/releases/$JOB_ID"
      # 发布不执行测试（测试由提交前负责）
      as_builder bash -c "cd '$BUILD_SOURCE/quant/web' && pnpm install --frozen-lockfile && pnpm build"
      reject_symlinks "$BUILD_SOURCE/quant/web/dist"
      rsync -a --delete \
        --safe-links \
        --exclude '.venv' --exclude '__pycache__' --exclude '*.pyc' \
        --exclude 'web/node_modules' --exclude 'web/dist' --exclude 'config.toml' \
        "$BUILD_SOURCE/quant/" "$QUANT_ROOT/releases/$JOB_ID/"
      rsync -a --delete --no-links "$BUILD_SOURCE/quant/web/dist/" "$QUANT_ROOT/releases/$JOB_ID/web/dist/"
      install -o root -g "$HANK_USER" -m 640 "$QUANT_ROOT/config.toml" "$QUANT_ROOT/releases/$JOB_ID/config.toml"
      chown -R "$BUILD_USER:$BUILD_USER" "$QUANT_ROOT/releases/$JOB_ID"
      as_builder bash -c "cd '$QUANT_ROOT/releases/$JOB_ID' && UV_HTTP_TIMEOUT=300 uv sync --frozen"
      chown -R root:root "$QUANT_ROOT/releases/$JOB_ID"
      chown root:"$HANK_USER" "$QUANT_ROOT/releases/$JOB_ID/config.toml"
      [[ -n "$PREV_QUANT" ]] && atomic_link "$PREV_QUANT" "$QUANT_ROOT/previous"
      atomic_link "$QUANT_ROOT/releases/$JOB_ID" "$QUANT_ROOT/current"
      SWITCHED_TARGETS+=(quant)
      systemctl restart hank-quant
      health_check "http://127.0.0.1:8100/api/health"
      ;;
    quant_slidev)
      mkdir -p "$SLIDEV_ROOT/releases/$JOB_ID"
      as_builder bash -c "cd '$BUILD_SOURCE/quant/slidev' && pnpm install --frozen-lockfile && pnpm build"
      reject_symlinks "$BUILD_SOURCE/quant/slidev/dist"
      rsync -a --delete --no-links "$BUILD_SOURCE/quant/slidev/dist/" "$SLIDEV_ROOT/releases/$JOB_ID/"
      [[ -n "$PREV_SLIDEV" ]] && atomic_link "$PREV_SLIDEV" "$SLIDEV_ROOT/previous"
      atomic_link "$SLIDEV_ROOT/releases/$JOB_ID" "$SLIDEV_ROOT/current"
      SWITCHED_TARGETS+=(quant_slidev)
      nginx -t
      systemctl reload nginx
      health_check "http://127.0.0.1:3030/"
      ;;
    docs)
      mkdir -p "$DOCS_ROOT/releases/$JOB_ID"
      chown "$BUILD_USER:$BUILD_USER" "$DOCS_ROOT/releases/$JOB_ID"
      as_builder mdbook build "$BUILD_SOURCE/docs" --dest-dir "$DOCS_ROOT/releases/$JOB_ID"
      reject_symlinks "$DOCS_ROOT/releases/$JOB_ID"
      chown -R root:root "$DOCS_ROOT/releases/$JOB_ID"
      [[ -n "$PREV_DOCS" ]] && atomic_link "$PREV_DOCS" "$DOCS_ROOT/previous"
      atomic_link "$DOCS_ROOT/releases/$JOB_ID" "$DOCS_ROOT/current"
      SWITCHED_TARGETS+=(docs)
      nginx -t
      systemctl reload nginx
      health_check "http://127.0.0.1:3002/"
      ;;
  esac
done

as_hank git -C /opt/hank-src update-ref refs/heads/trace-production "$COMMIT_SHA" "$BASE_SHA"
REF_SWITCHED=1
write_result succeeded "部署完成，所有目标健康检查通过"
